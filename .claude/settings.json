{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "effortLevel": "medium",
  "statusLine": {"type": "command", "command": "sh \"${CLAUDE_PROJECT_DIR:-.}\"/.claude/statusline.sh"},
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git switch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git fetch*)",
      "Bash(git rebase origin/main*)",
      "Bash(git push origin*)",
      "Bash(git push --force-with-lease*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr edit*)",
      "Bash(gh run view*)",
      "Bash(gh issue view*)",
      "Bash(gh pr merge --auto --squash --delete-branch)",
      "Bash(gh pr merge --auto --squash --delete-branch *)",
      "Bash(gh pr merge * --squash --delete-branch)",
      "Bash(git worktree list*)",
      "Bash(.claude/bin/session.sh *)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./**/.claude/bin/session.sh)",
      "Edit(./**/.claude/statusline.sh)",
      "Edit(./.claude/hooks/**)",
      "Edit(./.github/**)",
      "Bash(dangerouslyDisableSandbox:true)",
      "Bash(*merge-ok*)",
      "Bash(gh label*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.git-credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Edit(./PERSONAL_DATA/**)",
      "Read(./PERSONAL_DATA/**)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)",
      "Bash(gh repo delete*)",
      "Bash(gh api *rulesets*)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push --force origin main*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * *:main)",
      "Bash(git push * *:refs/heads/main)",
      "Bash(gh * --body-file *.env*)",
      "Bash(gh * --body-file=*.env*)",
      "Bash(gh * -F *.env*)",
      "Bash(gh gist *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sed -i*)",
      "Bash(perl -pi*)",
      "Bash(git worktree remove -f*)",
      "Bash(git worktree remove --force*)",
      "Bash(pkill*)",
      "Bash(killall*)",
      "Bash(git add -f*)",
      "Bash(git add --force*)",
      "Bash(git add * -f*)",
      "Bash(git add * --force*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "docker *",
      ".claude/bin/session.sh *"
    ],
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "registry.npmjs.org"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.git-credentials",
          "mode": "deny"
        },
        {
          "path": "~/.netrc",
          "mode": "deny"
        },
        {
          "path": "~/.npmrc",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "denyRead": [
        "./PERSONAL_DATA"
      ],
      "denyWrite": [
        "./PERSONAL_DATA",
        "./.claude/bin/session.sh",
        "./**/.claude/bin/session.sh",
        "./.claude/statusline.sh",
        "./**/.claude/statusline.sh"
      ]
    }
  }
}
